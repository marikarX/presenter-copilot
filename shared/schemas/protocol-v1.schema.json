{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presenter-copilot.local/schemas/protocol-v1.schema.json",
  "title": "Presenter Copilot IPC protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": true,
      "required": ["protocol_version", "type", "request_id", "method", "params"],
      "properties": {
        "protocol_version": { "const": 1 },
        "type": { "const": "request" },
        "request_id": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": true,
      "required": ["protocol_version", "type", "request_id", "ok"],
      "properties": {
        "protocol_version": { "const": 1 },
        "type": { "const": "response" },
        "request_id": { "type": ["string", "null"] },
        "ok": { "type": "boolean" },
        "result": {},
        "error": { "$ref": "#/$defs/error" }
      },
      "allOf": [
        {
          "if": { "properties": { "ok": { "const": true } } },
          "then": { "required": ["result"], "not": { "required": ["error"] } }
        },
        {
          "if": { "properties": { "ok": { "const": false } } },
          "then": { "required": ["error"], "not": { "required": ["result"] } }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": true,
      "required": ["protocol_version", "type", "event", "payload"],
      "properties": {
        "protocol_version": { "const": 1 },
        "type": { "const": "event" },
        "event": { "type": "string", "minLength": 1 },
        "payload": { "type": "object" }
      }
    }
  }
}
