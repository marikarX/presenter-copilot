{
  "name": "@presenter-copilot/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Local-first AI copilot for high-stakes presentations",
  "author": "Presenter Copilot contributors",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "pnpm build:main && pnpm build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "generate:icon": "node scripts/generate-app-icon.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"scripts/**/*.mjs\" \"../../scripts/**/*.mjs\" \"*.{json,mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"scripts/**/*.mjs\" \"../../scripts/**/*.mjs\" \"*.{json,mjs,ts}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "jszip": "3.10.2",
    "pptx-glimpse": "5.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@aiden0z/pptx-renderer": "1.3.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@xmldom/xmldom": "0.8.15",
    "electron": "44.1.0",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "pdfjs-dist": "5.4.624",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
